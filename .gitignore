# --- Data Protection ---
# Ignore raw data files (usually too large for GitHub)
data/raw/*
# Keep the folder structure but ignore the content
!data/raw/.gitkeep

# Ignore generated intermediate/processed data (aligned CSVs, wide matrices)
data/processed/*
# ...except the protein-id -> gene-symbol lookup. It is small (~450 KB), stable,
# and required at runtime by the interpretation panels, so it ships with the
# repo like src/graph/hetero_graph.pt does rather than forcing every clone to
# re-download STRING's 19 MB alias file to rebuild it.
!data/processed/protein_symbol_map.csv

# --- Python Junk ---
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/

# --- Jupyter Notebooks ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- OS Specific ---
.DS_Store
Thumbs.db

# --- Environment Secrets (If you use Supabase/API keys later) ---
.env

# Context for VSCode Agent
PROJECT_CONTEXT.md